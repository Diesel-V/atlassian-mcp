# Non-secret settings. Secrets are NOT set here: every secret is read from a file
# named by <NAME>_FILE, rendered by Vault Agent into /run/atlassian-mcp/secrets
# (mounted as /run/secrets). Setting both NAME and NAME_FILE is an error.

# --- service ---
PUBLIC_URL=https://atlassian-mcp.example.com
LISTEN_ADDR=:8080
METRICS_ADDR=:9090
LOG_LEVEL=info
# TLS between the reverse proxy and the VM
TLS_CERT_FILE=/tls/tls.crt
TLS_KEY_FILE=/tls/tls.key
# Corporate CA bundle inside the container, if Keycloak/Confluence/Jira use an internal CA
# CA_FILE=/etc/ssl/certs/corp-ca.crt

# --- pilot scope (security requirements) ---
# Approved Confluence spaces and Jira projects, comma-separated. Required for each
# enabled product; "*" lifts the restriction (and enables raw JQL) — only by decision.
CONFLUENCE_ALLOWED_SPACES=TECHOPS,DEVDOCS
JIRA_ALLOWED_PROJECTS=OD,DEVOPS
# Only members of this Keycloak group (needs a "groups" mapper on the access and ID tokens)
KEYCLOAK_REQUIRED_GROUP=/ai-pilot
KEYCLOAK_GROUPS_CLAIM=groups
# Pilot: access through Open WebUI only
ENABLE_API_KEYS=false
ENABLE_AGENTS=false

# --- storage (runtime role amcp_app, see deploy/postgres-roles.sql) ---
DATABASE_URL_FILE=/run/secrets/database_url
# The runtime role may not change the schema; run "migrate" as amcp_migrator instead.
MIGRATE_ON_START=false
# openssl rand -base64 32; losing ENCRYPTION_KEY invalidates all stored grants
ENCRYPTION_KEY_FILE=/run/secrets/encryption_key
SESSION_KEY_FILE=/run/secrets/session_key

# --- Keycloak ---
KEYCLOAK_ISSUER=https://auth.example.com/realms/<realm>
# azp of tokens accepted as end users (Open WebUI forwards its users' tokens)
KEYCLOAK_USER_CLIENTS=open-webui
# confidential client for the "My access" page, redirect URI: ${PUBLIC_URL}/login/callback
KEYCLOAK_WEB_CLIENT_ID=atlassian-mcp
KEYCLOAK_WEB_CLIENT_SECRET_FILE=/run/secrets/keycloak_web_client_secret
USERNAME_CLAIM=preferred_username
# preferred_username is an e-mail; Confluence/Jira usernames are the local part
USERNAME_STRIP_DOMAIN=example.com

# --- Confluence (incoming application link, redirect: ${PUBLIC_URL}/oauth/confluence/callback) ---
CONFLUENCE_URL=https://confluence.example.com
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET_FILE=/run/secrets/confluence_client_secret
CONFLUENCE_SCOPES=READ

# --- Jira (incoming application link, redirect: ${PUBLIC_URL}/oauth/jira/callback) ---
JIRA_URL=https://jira.example.com
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET_FILE=/run/secrets/jira_client_secret
JIRA_SCOPES=READ

# --- limits ---
API_KEY_DEFAULT_TTL=2160h
API_KEY_MAX_TTL=4320h
RATE_LIMIT_PER_MINUTE=60
HTTP_TIMEOUT=20s
MAX_SEARCH_RESULTS=20
MAX_CONTENT_CHARS=20000
SESSION_TTL=8h

# --- audit ---
# Entries older than this are deleted daily. 0 keeps them forever.
AUDIT_RETENTION=8760h
