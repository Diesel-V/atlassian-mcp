# --- service ---
PUBLIC_URL=https://mcp-atlassian.example.com
LISTEN_ADDR=:8080
METRICS_ADDR=:9090
LOG_LEVEL=info
# Corporate CA bundle inside the container, if Keycloak/Confluence/Jira use an internal CA
# CA_FILE=/etc/ssl/certs/ca-certificates.crt

# --- storage ---
DATABASE_URL=postgres://amcp:CHANGE_ME@postgres:5432/amcp?sslmode=disable
# openssl rand -base64 32  (different values; keep ENCRYPTION_KEY safe: losing it invalidates all stored grants)
ENCRYPTION_KEY=
SESSION_KEY=

# --- Keycloak ---
KEYCLOAK_ISSUER=https://auth.example.com/realms/<realm>
# azp of tokens accepted as end users (Open WebUI forwards its users' tokens)
KEYCLOAK_USER_CLIENTS=open-webui
# confidential client for the "My access" page, redirect URI: ${PUBLIC_URL}/login/callback
KEYCLOAK_WEB_CLIENT_ID=atlassian-mcp
KEYCLOAK_WEB_CLIENT_SECRET=
USERNAME_CLAIM=preferred_username
# preferred_username is an e-mail; Confluence/Jira usernames are the local part
USERNAME_STRIP_DOMAIN=example.com

# --- Confluence (incoming application link, redirect: ${PUBLIC_URL}/oauth/confluence/callback) ---
CONFLUENCE_URL=https://confluence.example.com
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
CONFLUENCE_SCOPES=READ

# --- Jira (incoming application link, redirect: ${PUBLIC_URL}/oauth/jira/callback) ---
JIRA_URL=https://jira.example.com
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_SCOPES=READ

# --- limits ---
API_KEY_DEFAULT_TTL=2160h
API_KEY_MAX_TTL=4320h
RATE_LIMIT_PER_MINUTE=60
HTTP_TIMEOUT=20s
MAX_SEARCH_RESULTS=20
MAX_CONTENT_CHARS=20000
SESSION_TTL=8h

# --- audit ---
# Entries older than this are deleted daily. 0 keeps them forever.
AUDIT_RETENTION=8760h
